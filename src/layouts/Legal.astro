---
import Base from "./Base.astro";

interface Props {
  title: string;
  heading: string;
  updated?: string;
}

const { title, heading, updated } = Astro.props;
---

<Base title={title}>
  <header class="container-narrow pt-10 pb-8">
    <a href="/" class="eyebrow link-underline link-draw">← Damien Pugin</a>
  </header>

  <main class="container-narrow pb-24">
    <h1 class="text-4xl md:text-5xl mb-3">{heading}</h1>
    {updated && <p class="eyebrow mb-10">Mise à jour · {updated}</p>}

    <article class="prose-legal text-[16px] leading-[1.75] text-[color:var(--color-ink-2)]">
      <slot />
    </article>
  </main>

  <footer class="border-t hairline">
    <div class="container-narrow py-8 flex flex-wrap gap-4 items-center justify-between text-sm text-[color:var(--color-muted)]">
      <span>© {new Date().getFullYear()} Damien Pugin.</span>
      <a href="/" class="link-underline link-draw">Retour à l'accueil</a>
    </div>
  </footer>
</Base>

<style is:global>
  .prose-legal h2 {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-legal h3 {
    font-size: 1.15rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .prose-legal p,
  .prose-legal ul,
  .prose-legal ol {
    margin-bottom: 1rem;
  }
  .prose-legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-legal a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-hairline-2);
  }
  .prose-legal a:hover {
    text-decoration-color: var(--color-gold);
  }
</style>
