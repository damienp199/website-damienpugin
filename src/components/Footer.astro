---
import { site } from "../content/site";
const { nav, footer } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer border-t hairline">
  <div class="container-prose site-footer__inner">
    <div class="site-footer__brand">
      <span class="wordmark">
        <span class="wordmark__first">{nav.brand.first}</span>
        <span class="wordmark__dot">·</span>
        <span class="wordmark__last">{nav.brand.last}</span>
      </span>
      <p class="site-footer__copy">© {year} {footer.copyright}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Liens légaux">
      {footer.links.map((l) => (
        <a href={l.href} class="link-underline link-draw">{l.label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-paper);
  }
  .site-footer__inner {
    padding-block: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    font-variation-settings: "opsz" 24;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .wordmark__dot { color: var(--color-gold); }
  .site-footer__copy {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .site-footer__nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.85rem;
    color: var(--color-ink-2);
  }
  .site-footer__nav a { text-decoration: none; }
</style>
