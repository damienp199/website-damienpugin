---
import { site } from "../content/site";
const { nav, footer } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer border-t hairline">
  <div class="container-prose site-footer__inner">
    <div class="site-footer__brand">
      <span class="wordmark">
        <span class="wordmark__a">damien</span><span class="wordmark__b">pugin</span><span class="wordmark__br">]</span>
      </span>
      <p class="site-footer__copy">© {year} {footer.copyright}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Liens légaux">
      {footer.links.map((l) => (
        <a href={l.href} class="link-underline link-draw">{l.label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-paper);
  }
  .site-footer__inner {
    padding-block: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .wordmark {
    font-family: "Author", system-ui, sans-serif;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--color-ink);
    display: inline-flex;
    align-items: baseline;
  }
  .wordmark__a { font-weight: 300; letter-spacing: -0.005em; }
  .wordmark__b { font-weight: 700; letter-spacing: -0.02em; }
  .wordmark__br { color: var(--color-gold); font-weight: 500; margin-left: 0.04em; }
  .site-footer__copy {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .site-footer__nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.85rem;
    color: var(--color-ink-2);
  }
  .site-footer__nav a { text-decoration: none; }
</style>
