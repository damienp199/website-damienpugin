---
import { site } from "../content/site";
const { nav } = site;
---

<nav class="site-nav" aria-label="Navigation principale">
  <div class="site-nav__inner">
    <a href="#top" class="wordmark" aria-label={`${nav.brand.first} ${nav.brand.last} — accueil`}>
      <span class="wordmark__a">damien</span><span class="wordmark__b">pugin</span><span class="wordmark__br">]</span>
    </a>

    <a href="#newsletter" class="nav-cta link-underline link-draw">
      {nav.cta} <span aria-hidden="true">→</span>
    </a>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 50;
    pointer-events: none;
  }
  .site-nav__inner {
    pointer-events: auto;
    max-width: 68rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: color-mix(in oklab, var(--color-paper) 86%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
  }

  .wordmark {
    font-family: "Author", system-ui, sans-serif;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--color-ink);
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
  }
  .wordmark__a {
    font-weight: 300;
    letter-spacing: -0.005em;
  }
  .wordmark__b {
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .wordmark__br {
    color: var(--color-gold);
    font-weight: 500;
    margin-left: 0.04em;
  }

  .nav-cta {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    text-decoration: none;
  }
</style>
