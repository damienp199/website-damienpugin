---
// PROTOTYPE JETABLE — redesign du site avec le design system Paradigm.
// Trois variantes structurellement différentes sur cette route, switchables via ?variant=A|B|C
// (barre flottante en bas, ← → au clavier). A = colonne document, B = rail latéral, C = grille.
import "../styles/prototype/tokens.css";
import "../styles/prototype/bundle.css";
import VariantA from "../components/prototype/VariantA.astro";
import VariantB from "../components/prototype/VariantB.astro";
import VariantC from "../components/prototype/VariantC.astro";
import Switcher from "../components/prototype/Switcher.astro";
import { site } from "../content/site";

const variants = [
  { key: "A", name: "Document" },
  { key: "B", name: "Rail" },
  { key: "C", name: "Grille" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>[Prototype] {site.meta.title}</title>
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem("proto-theme"); } catch (e) {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <div data-variant="A"><VariantA /></div>
    <div data-variant="B" hidden><VariantB /></div>
    <div data-variant="C" hidden><VariantC /></div>
    <Switcher variants={variants} />

    <script>
      // Bascule de thème
      document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("proto-theme", next); } catch {}
        });
      });

      // Formulaires : stub (prototype). Validation + notice, pas d'envoi.
      const showNotice = (text: string) => {
        document.querySelector(".pd-notice.is-proto")?.remove();
        const n = document.createElement("div");
        n.className = "pd-notice is-proto";
        n.textContent = text;
        document.body.appendChild(n);
        requestAnimationFrame(() => n.classList.add("is-in"));
        setTimeout(() => n.remove(), 2800);
      };
      document.querySelectorAll<HTMLFormElement>("[data-proto-form]").forEach((form) => {
        const input = form.querySelector<HTMLInputElement>("input[type=email]")!;
        const err = form.querySelector<HTMLElement>("[data-proto-error]")!;
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const ok = input.validity.valid;
          err.hidden = ok;
          input.classList.toggle("mod-error", !ok);
          if (!ok) { input.focus(); return; }
          form.reset();
          showNotice("Inscription simulée. Le prototype n'envoie rien à Kit.");
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /* Base site : ui 15px (README « ui 15px pour un site »), lecture en .body 18px */
  html { background: var(--bg); }
  body { font: 15px/1.4 var(--font-sans); color: var(--text); background: var(--bg); -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  h1, h2, h3, p, ul, ol, blockquote, figure { margin: 0; }
  ul, ol { padding: 0; list-style: none; }
  ::selection { background: var(--selection); }
  :focus-visible { outline: 2px solid rgba(231, 111, 81, 0.6); outline-offset: 2px; }
  iframe { display: block; border: 0; }

  a.link { color: var(--link); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--link) 40%, transparent); text-underline-offset: 2px; }
  a.link:hover { color: var(--link-hover); text-decoration-color: color-mix(in srgb, var(--link-hover) 40%, transparent); }
  a.quiet { color: inherit; text-decoration: none; }
  a.quiet:hover { color: var(--text); }

  .muted { color: var(--text-muted); }
  .faint { color: var(--text-faint); }
  .brand { color: var(--accent); }
  :root:not([data-theme="dark"]) .brand { filter: brightness(0.8); }

  .pd-quote { padding: var(--space-12) var(--space-16); background: var(--quote-bg); color: var(--quote-text); font-style: italic; border-left: 2px solid var(--accent); border-radius: 0 var(--radius-m) var(--radius-m) 0; }

  .pd-notice.is-proto { position: fixed; top: 16px; left: 50%; transform: translate(-50%, -8px); opacity: 0; transition: opacity .15s ease, transform .15s ease; z-index: 900; pointer-events: none; }
  .pd-notice.is-proto.is-in { opacity: 1; transform: translate(-50%, 0); }

  .pd-button.mod-icon.theme-toggle .ico-sun { display: none; }
  [data-theme="dark"] .pd-button.mod-icon.theme-toggle .ico-sun { display: block; }
  [data-theme="dark"] .pd-button.mod-icon.theme-toggle .ico-moon { display: none; }

  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; } }
</style>
