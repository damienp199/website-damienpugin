---
// Pages de remerciement Kit : un message, pas de bouton d'action.
import Paradigm from "./Paradigm.astro";
import SiteHeader from "../components/prototype/SiteHeader.astro";
import SiteFooter from "../components/prototype/SiteFooter.astro";

interface Props { title: string; eyebrow?: string; heading: string; accent?: string }
const { title, eyebrow, heading, accent } = Astro.props;
---

<Paradigm title={title}>
  <SiteHeader cta={false} />
  <main class="pg-wrap ty">
    {eyebrow && <p class="ty-lead">{eyebrow}</p>}
    <h1>{heading}{accent && <> <span class="ty-accent">{accent}</span></>}</h1>
    <div class="ty-body"><slot /></div>
    <p class="ty-back"><a class="pd-button" href="/">Retour à l'accueil</a></p>
  </main>
  <SiteFooter />
</Paradigm>

<style>
  .ty { min-height: calc(100svh - 64px - 160px); padding-block: clamp(56px, 10vw, 128px) clamp(72px, 10vw, 128px); }
  .ty-lead { margin-bottom: var(--space-16); font-size: clamp(19px, 1.8vw, 24px); font-weight: 500; color: var(--text-muted); }
  h1 { font-size: clamp(52px, 10vw, 136px); line-height: 0.98; font-weight: 700; letter-spacing: -0.04em; text-wrap: balance; }
  .ty-accent { color: var(--accent); }
  .ty-body { max-width: 38em; margin-top: clamp(32px, 5vw, 64px); font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: var(--text-muted); }
  .ty-body :global(p), .ty-body :global(ol) { margin-bottom: var(--space-16); }
  .ty-body :global(strong) { font-weight: 600; color: var(--text); }
  .ty-body :global(ol) { padding-left: 1.3em; list-style: decimal; }
  .ty-body :global(li) { margin-bottom: var(--space-8); }
  .ty-body :global(li::marker) { color: var(--text-faint); }
  .ty-body :global(a) { color: var(--link); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--link) 40%, transparent); text-underline-offset: 3px; }
  .ty-body :global(a:hover) { color: var(--link-hover); }
  .ty-body :global(.thanks__signoff) { margin-top: var(--space-32); margin-bottom: 0; font-weight: 500; color: var(--text); }
  .ty-back { margin-top: clamp(40px, 5vw, 64px); }
  .ty-back .pd-button { display: inline-block; padding: 9px 16px; text-decoration: none; }
</style>
