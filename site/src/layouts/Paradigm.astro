---
// Coquille commune à toutes les pages : design system Paradigm, thème sombre uniquement.
import "../styles/prototype/tokens.css";
import "../styles/prototype/bundle.css";
import { proto } from "../content/prototype";

interface Props { title?: string; description?: string }
const { title = proto.meta.title, description = proto.meta.description } = Astro.props;
---

<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e1e1e" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes="256x256" href="/apple-touch-icon-dark.png" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Clic sur une ancre : la page défile jusqu'à la section au lieu de sauter */
  html { background: var(--bg); scroll-behavior: smooth; }
  body { font: 15px/1.4 var(--font-sans); color: var(--text); background: var(--bg); -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  h1, h2, h3, p, ul, ol, blockquote, figure { margin: 0; }
  ul, ol { padding: 0; list-style: none; }
  ::selection { background: var(--selection); }
  :focus-visible { outline: 2px solid rgba(231, 111, 81, 0.6); outline-offset: 2px; }
  iframe { display: block; border: 0; }

  a.quiet { color: inherit; text-decoration: none; }
  a.quiet:hover { color: var(--text); }
  .muted { color: var(--text-muted); }

  /* Pages simples (légales, remerciement) : même gouttière que l'accueil */
  .pg-wrap { --pad: clamp(20px, 5vw, 72px); max-width: calc(1184px + 2 * var(--pad)); margin-inline: auto; padding-inline: var(--pad); }
  /* Action : sienna, texte sombre (5,3:1) */
  .pd-button.mod-primary { display: inline-flex; align-items: center; gap: var(--space-12); color: var(--grey-100); text-decoration: none; transition: background 0.15s ease, border-color 0.15s ease; }
  .pd-button.mod-primary:hover { background: color-mix(in srgb, var(--accent) 86%, var(--grey-100)); border-color: color-mix(in srgb, var(--accent) 86%, var(--grey-100)); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: 0.01ms !important; }
  }
</style>
