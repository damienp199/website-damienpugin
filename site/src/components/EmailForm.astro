---
interface Props {
  formId?: string;
  placeholder?: string;
  cta?: string;
  variant?: "hero" | "block";
  id?: string;
}

const {
  formId = "1528990",
  placeholder = "Ma meilleure adresse email",
  cta = "Je suis la mise en place en direct",
  variant = "hero",
  id = "newsletter-form",
} = Astro.props;

const action = `https://app.convertkit.com/forms/${formId}/subscriptions`;
---

<form
  id={id}
  class:list={["ck-form", variant === "hero" ? "ck-hero" : "ck-block"]}
  action={action}
  method="post"
  data-ck-form
  novalidate
>
  <input type="hidden" name="lead_magnet" value="none" />

  <div class="ck-row">
    <label for={`${id}-email`} class="sr-only">Adresse email</label>
    <input
      id={`${id}-email`}
      name="email_address"
      type="email"
      required
      autocomplete="email"
      placeholder={placeholder}
      class="ck-input"
    />
    <button type="submit" class="btn-gold ck-submit" data-default={cta} data-wait="Envoi…">
      <span class="ck-submit-label">{cta}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>
  </div>

  <p class="ck-status" role="status" aria-live="polite"></p>
</form>

<style>
  .ck-form { width: 100%; }

  .ck-row {
    display: flex;
    gap: 0.5rem;
    background: white;
    border: 1px solid var(--color-hairline-2);
    padding: 0.4rem;
    border-radius: 2px;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .ck-row:focus-within {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 3px rgba(2, 6, 23, 0.04);
  }

  .ck-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    padding: 0.75rem 0.85rem;
    font: inherit;
    font-size: 1rem;
    color: var(--color-ink);
  }
  .ck-input::placeholder { color: var(--color-muted-2); }

  .ck-submit { white-space: nowrap; }

  .ck-status {
    margin-top: 0.85rem;
    min-height: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .ck-status.is-error { color: #b91c1c; }
  .ck-status.is-success { color: #166534; }

  .ck-block .ck-row {
    background: white;
  }

  @media (max-width: 560px) {
    .ck-row {
      flex-direction: column;
      padding: 0.5rem;
    }
    .ck-submit { width: 100%; padding: 0.95rem 1rem; }
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>("form[data-ck-form]");

  forms.forEach((form) => {
    const status = form.querySelector<HTMLElement>(".ck-status");
    const btn = form.querySelector<HTMLButtonElement>(".ck-submit");
    const label = form.querySelector<HTMLElement>(".ck-submit-label");
    const input = form.querySelector<HTMLInputElement>('input[name="email_address"]');
    const defaultLabel = btn?.dataset.default ?? "";
    const waitLabel = btn?.dataset.wait ?? "Envoi…";

    const setStatus = (msg: string, type: "" | "error" | "success" = "") => {
      if (!status) return;
      status.textContent = msg;
      status.classList.remove("is-error", "is-success");
      if (type) status.classList.add(`is-${type}`);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!input || !btn) return;

      if (!input.validity.valid) {
        setStatus("Entre une adresse email valide.", "error");
        input.focus();
        return;
      }

      btn.disabled = true;
      if (label) label.textContent = waitLabel;
      setStatus("");

      try {
        const fd = new FormData(form);
        await fetch(form.action, {
          method: "POST",
          body: fd,
          mode: "no-cors",
        });

        form.reset();
        setStatus("Merci. Vérifie ta boîte mail pour confirmer ton inscription.", "success");
        if (label) label.textContent = "Inscrit ✓";
      } catch {
        setStatus("Oups, une erreur est survenue. Réessaie dans un instant.", "error");
        if (label) label.textContent = defaultLabel;
        btn.disabled = false;
      }
    });
  });
</script>
