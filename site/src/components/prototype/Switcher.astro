---
// Barre flottante de switch de variantes. Rendue en dev seulement.
interface Props { variants: { key: string; name: string }[] }
const { variants } = Astro.props;
const isDev = import.meta.env.DEV;
---
{isDev && (
  <div class="proto-bar" role="group" aria-label="Variantes du prototype" data-proto-switcher data-variants={JSON.stringify(variants)}>
    <button type="button" data-proto-prev aria-label="Variante précédente">←</button>
    <span data-proto-label>…</span>
    <button type="button" data-proto-next aria-label="Variante suivante">→</button>
  </div>
)}

<style>
  .proto-bar {
    position: fixed; bottom: 72px; left: 50%; transform: translateX(-50%); z-index: 1000;
    display: flex; align-items: center; gap: 6px; padding: 6px 8px;
    background: #111; color: #fff; border-radius: 999px; box-shadow: 0 6px 24px rgba(0,0,0,.35);
    font: 500 13px/1 ui-monospace, Menlo, monospace;
  }
  .proto-bar button { font: inherit; color: inherit; background: #333; border: 0; border-radius: 999px; width: 28px; height: 28px; cursor: pointer; }
  .proto-bar button:hover { background: #555; }
  .proto-bar span { padding: 0 8px; min-width: 150px; text-align: center; }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-proto-switcher]");
  if (bar) {
    const variants: { key: string; name: string }[] = JSON.parse(bar.dataset.variants ?? "[]");
    const keys = variants.map((v) => v.key);
    const label = bar.querySelector<HTMLElement>("[data-proto-label]")!;

    const current = () => {
      const k = new URLSearchParams(location.search).get("variant")?.toUpperCase() ?? keys[0];
      return keys.includes(k) ? k : keys[0];
    };

    const apply = (k: string) => {
      document.querySelectorAll<HTMLElement>("[data-variant]").forEach((el) => {
        el.hidden = el.dataset.variant !== k;
      });
      label.textContent = `${k} (${variants.find((v) => v.key === k)?.name ?? ""})`;
      const url = new URL(location.href);
      url.searchParams.set("variant", k);
      history.replaceState(null, "", url);
      window.scrollTo(0, 0);
    };

    const step = (d: number) => {
      const i = keys.indexOf(current());
      apply(keys[(i + d + keys.length) % keys.length]);
    };

    bar.querySelector("[data-proto-prev]")!.addEventListener("click", () => step(-1));
    bar.querySelector("[data-proto-next]")!.addEventListener("click", () => step(1));
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement | null;
      if (t && (t.matches("input, textarea, select") || t.isContentEditable)) return;
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });

    apply(current());
  }
</script>
