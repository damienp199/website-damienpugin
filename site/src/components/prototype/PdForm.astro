---
// Formulaire email Paradigm : pd-input + pd-button mod-primary. PROTOTYPE : envoi stubé (notice), pas de POST vers Kit.
interface Props { id: string; cta: string; placeholder: string; stacked?: boolean }
const { id, cta, placeholder, stacked = false } = Astro.props;
---
<form class:list={["pd-form", { "is-stacked": stacked }]} data-proto-form novalidate>
  <label for={id} class="sr-only">Adresse email</label>
  <input id={id} class="pd-input" type="email" name="email_address" required autocomplete="email" placeholder={placeholder} />
  <button type="submit" class="pd-button mod-primary">{cta}</button>
  <p class="pd-field-hint mod-error" data-proto-error hidden>Entre une adresse email valide.</p>
</form>

<style>
  .pd-form { display: flex; gap: var(--space-8); flex-wrap: wrap; }
  .pd-form .pd-input { flex: 1 1 220px; min-width: 0; width: auto; padding: var(--space-8) var(--space-12); font-size: 15px; }
  .pd-form .pd-button { padding: var(--space-8) var(--space-16); font-size: 15px; white-space: nowrap; }
  .pd-form.is-stacked { flex-direction: column; }
  .pd-form.is-stacked .pd-input { flex-basis: auto; }
  .pd-form [data-proto-error] { flex-basis: 100%; margin: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>
