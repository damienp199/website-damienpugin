---
// Variante C — « Grille » : page large (1080px), hero en deux colonnes avec carte de capture, sections en cellules bordées (trait 1px, pas d'ombre).
import Icon from "./Icon.astro";
import PdForm from "./PdForm.astro";
import { site } from "../../content/site";
const { nav, hero, problem, method, podcast, testimonials, about, newsletter, footer } = site;
const inline = (s: string) => s.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

<div class="vc">
  <header class="vc-bar">
    <div class="vc-wrap vc-bar-in">
      <a href="#top" class="quiet vc-name">{nav.brand.first} {nav.brand.last}</a>
      <nav class="vc-nav" aria-label="Sections">
        <a class="quiet muted" href="#probleme">Problème</a>
        <a class="quiet muted" href="#methode">Méthode</a>
        <a class="quiet muted" href="#podcast">Podcast</a>
        <a class="quiet muted" href="#temoignages">Témoignages</a>
        <a class="quiet muted" href="#about">À propos</a>
      </nav>
      <div class="vc-bar-actions">
        <button class="pd-button mod-icon theme-toggle" data-theme-toggle aria-label="Changer de thème">
          <Icon name="sun" class="ico-sun" /><Icon name="moon" class="ico-moon" />
        </button>
        <a href="#newsletter" class="pd-button">{nav.cta}</a>
      </div>
    </div>
  </header>

  <main class="vc-wrap" id="top">
    <section class="vc-hero">
      <div class="vc-hero-text">
        <p class="caption muted">{hero.eyebrow}</p>
        <h1 class="title">{hero.title} <span class="brand">{hero.titleAccent}</span></h1>
        <p class="body muted">{hero.sub}</p>
      </div>
      <div class="vc-card">
        <div class="vc-card-title"><Icon name="radio" size={16} /> {hero.proof}</div>
        <PdForm id="vc-hero-email" cta={hero.cta} placeholder={newsletter.placeholder} stacked />
        <p class="caption muted">{newsletter.disclaimer}</p>
      </div>
    </section>

    <section class="vc-sec" id="probleme">
      <h2 class="heading">{problem.title} {problem.titleBreak}</h2>
      <div class="vc-grid vc-grid-4">
        {problem.items.map((it) => (
          <div class="vc-cell">
            <div class="vc-cell-label">{it.label}</div>
            <p class="muted">{it.text}</p>
          </div>
        ))}
        <div class="vc-cell vc-cell-warn">
          <div class="vc-cell-label"><Icon name="triangle-alert" size={16} /> Résultat</div>
          <p>{problem.outcome}</p>
        </div>
      </div>
    </section>

    <section class="vc-sec" id="methode">
      <div class="vc-sec-head">
        <h2 class="heading">{method.title} <span class="brand">{method.titleAccent}</span></h2>
        <p class="muted">{method.intro}</p>
      </div>
      <ol class="vc-grid vc-grid-3">
        {method.steps.map((s) => (
          <li class="vc-cell">
            <span class="caption faint">{s.num}</span>
            <div class="vc-cell-label">{s.title}</div>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="vc-sec vc-two">
      <div id="podcast" class="vc-box">
        <div class="vc-box-head">
          <h2 class="heading">{podcast.title}</h2>
          <p class="muted">{podcast.sub}</p>
        </div>
        <iframe src={`https://player.captivate.fm/show/${podcast.captivateShowId}`} title="Podcast Damien Pugin" loading="lazy" scrolling="no" allow="clipboard-write"></iframe>
      </div>
      <div id="about" class="vc-box vc-about">
        <h2 class="heading">{about.title} {about.titleLine2} <span class="brand">{about.titleAccent}</span></h2>
        {about.paragraphs.map((p) => <p set:html={inline(p)} />)}
        <p><a href="#newsletter" class="link">{about.outro.linkText}</a> {about.outro.suffix}</p>
      </div>
    </section>

    <section class="vc-sec" id="temoignages">
      <h2 class="heading">{testimonials.title} {testimonials.titleBreak}</h2>
      <div class="vc-grid vc-grid-2">
        <div class="vc-cell vc-cell-video">
          <iframe src={`https://www.youtube.com/embed/${testimonials.featured.youtubeId}`} title={`Témoignage ${testimonials.featured.name}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
        <figure class="vc-cell">
          <blockquote class="pd-quote">{testimonials.featured.quote}</blockquote>
          <figcaption>
            <div class="vc-cell-label">{testimonials.featured.name}</div>
            <div class="caption muted">{testimonials.featured.title} · {testimonials.featured.site}</div>
          </figcaption>
        </figure>
        {testimonials.others.map((t) => (
          <figure class="vc-cell">
            <blockquote class="pd-quote">{t.quote}</blockquote>
            <figcaption>
              <div class="vc-cell-label">{t.name}</div>
              <div class="caption muted">{t.title}{t.site && ` · ${t.site}`}</div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="vc-sec" id="newsletter">
      <div class="vc-nl">
        <div class="vc-nl-text">
          <p class="caption muted">{newsletter.eyebrow}</p>
          <h2 class="heading">{newsletter.title} <span class="brand">{newsletter.titleAccent}</span></h2>
          <p class="muted">{newsletter.sub}</p>
        </div>
        <div class="vc-nl-form">
          <PdForm id="vc-nl-email" cta={newsletter.cta} placeholder={newsletter.placeholder} stacked />
          <p class="caption muted">{newsletter.disclaimer}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="vc-footer">
    <div class="vc-wrap vc-footer-in caption muted">
      <span>© {new Date().getFullYear()} {footer.copyright}</span>
      <nav class="vc-footer-links">{footer.links.map((l) => <a class="quiet" href={l.href}>{l.label}</a>)}</nav>
    </div>
  </footer>
</div>

<style>
  .vc-wrap { max-width: 1080px; margin-inline: auto; padding-inline: var(--space-32); }
  .vc-bar { position: sticky; top: 0; z-index: 10; background: var(--bg-bar); border-bottom: 1px solid var(--border); }
  .vc-bar-in { display: flex; align-items: center; gap: var(--space-24); padding-block: var(--space-8); min-height: 44px; }
  .vc-name { font-weight: 600; }
  .vc-nav { display: flex; gap: var(--space-16); }
  .vc-bar-actions { margin-left: auto; display: flex; align-items: center; gap: var(--space-8); }
  .vc-bar-actions .pd-button:not(.mod-icon) { text-decoration: none; }

  .vc-hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-32); align-items: center; padding-block: calc(var(--space-32) * 2.5); }
  .vc-hero-text { display: flex; flex-direction: column; gap: var(--space-16); max-width: 560px; }
  .vc-hero .title { text-wrap: balance; }
  .vc-card { display: flex; flex-direction: column; gap: var(--space-12); padding: var(--space-24); background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius-xl); }
  .vc-card-title { display: flex; align-items: center; gap: var(--space-8); font-weight: 500; }

  .vc-sec { display: flex; flex-direction: column; gap: var(--space-16); padding-block: var(--space-32); border-top: 1px solid var(--border); }
  .vc-sec-head { display: flex; flex-direction: column; gap: var(--space-8); max-width: var(--content-width); }
  .vc-sec > .heading { text-wrap: balance; }

  .vc-grid { display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; }
  .vc-grid-4 { grid-template-columns: repeat(4, 1fr); }
  .vc-grid-3 { grid-template-columns: repeat(3, 1fr); }
  .vc-grid-2 { grid-template-columns: repeat(2, 1fr); }
  .vc-cell { background: var(--bg); padding: var(--space-16); display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .vc-cell-label { display: flex; align-items: center; gap: var(--space-8); font-weight: 500; }
  .vc-cell-warn { background: rgba(244, 162, 97, 0.1); }
  .vc-cell-warn .vc-cell-label { color: var(--warning); }
  :root:not([data-theme="dark"]) .vc-cell-warn .vc-cell-label { filter: brightness(0.8); }
  .vc-cell-video { padding: 0; background: var(--bg-sunken); }
  .vc-cell-video iframe { width: 100%; height: 100%; min-height: 280px; aspect-ratio: 16 / 9; }
  .vc-cell figcaption { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-8); }

  .vc-two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-24); }
  .vc-box { display: flex; flex-direction: column; gap: var(--space-12); padding: var(--space-24); border: 1px solid var(--border); border-radius: var(--radius-l); min-width: 0; }
  .vc-box-head { display: flex; flex-direction: column; gap: var(--space-4); }
  .vc-box iframe { width: 100%; flex: 1; min-height: 520px; border-radius: var(--radius-m); }
  .vc-about { gap: var(--space-12); }
  .vc-about strong { font-weight: 600; }

  .vc-nl { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-32); padding: var(--space-32); background: var(--bg-sunken); border: 1px solid var(--border); border-radius: var(--radius-xl); }
  .vc-nl-text, .vc-nl-form { display: flex; flex-direction: column; gap: var(--space-8); }
  .vc-nl-form { justify-content: center; }

  .vc-footer { border-top: 1px solid var(--border); }
  .vc-footer-in { display: flex; flex-wrap: wrap; gap: var(--space-16); justify-content: space-between; padding-block: var(--space-24); }
  .vc-footer-links { display: flex; gap: var(--space-16); }

  @media (max-width: 900px) {
    .vc-wrap { padding-inline: var(--space-16); }
    .vc-nav { display: none; }
    .vc-hero, .vc-two, .vc-nl, .vc-grid-2 { grid-template-columns: 1fr; }
    .vc-grid-4 { grid-template-columns: 1fr 1fr; }
    .vc-grid-3 { grid-template-columns: 1fr; }
    .vc-hero { padding-block: var(--space-32); }
  }
  @media (max-width: 560px) {
    .vc-grid-4 { grid-template-columns: 1fr; }
  }
</style>
