---
// Variante A3R3 — « Grand format, hero sienna » : home Expert Asymétrique (philosophie + promesse, CTA WhatsApp).
// Titres XXL à gauche, contenu à droite (grille 5/7). Hero et contact en sienna plein cadre, philosophie sur bande sombre.
// Peu de texte : chaque section porte un visuel (pictos, schéma « tout passe par toi », pipeline, frise).
import Icon from "./Icon.astro";
import Wordmark from "./Wordmark.astro";
import Saw from "./Saw.astro";
import { site } from "../../content/site";
import { proto } from "../../content/prototype";
// problem : "statement" = titre affirmatif + résultat sous le schéma ; "question" = « Des revenus en ⩘ ? » à gauche, rien dessous
// nodes : rendu des domaines du schéma. pill = pastille noire ; picto = rond noir + picto + nom dessous ;
// outline = pastille blanche à contour sienna ; label = nom seul sur halo, point sienna.
interface Props { problemStyle?: "statement" | "question"; nodes?: "pill" | "picto" | "outline" | "label"; uid?: string }
const { problemStyle = "statement", nodes = "pill", uid = "a3" } = Astro.props;
// Pictos Lucide (grille 24) : aimant, colis, liste
const icons = [
  ["m6 15-4-4 6.75-6.77a7.79 7.79 0 0 1 11 11L13 22l-4-4 6.39-6.36a2.14 2.14 0 0 0-3-3L6 15", "m5 8 4 4", "m12 15 4 4"],
  ["M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z", "M12 22V12", "m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7", "m7.5 4.27 9 5.15"],
  ["M8 2h8v4H8z", "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2", "M12 11h4", "M12 16h4", "M8 11h.01", "M8 16h.01"],
];
const { podcast, testimonials: legacy, footer } = site;
const { whatsapp, hero, outcomes, problem, plan, philosophy, quotes, why, about, contact } = proto;
// Typo française : espace fine insécable avant ! ? ; : » et après «
const fr = (t: string) => t.replace(/ ([!?;:»])/g, "\u202F$1").replace(/« /g, "«\u202F");
// Témoignages : nouveaux puis anciens, même format (Jean + vidéo). Répartis en 2 colonnes équilibrées
// (glouton sur une hauteur estimée) pour éviter les trous d'une grille à rangées.
type Q = { text: string; name: string; title: string; video?: string };
const allQuotes: Q[] = [
  ...quotes.items.map((q) => ({ text: q.text, name: q.name, title: q.title })),
  { text: legacy.featured.quote, name: legacy.featured.name, title: legacy.featured.title, video: legacy.featured.youtubeId },
  ...legacy.others.map((q) => ({ text: q.quote, name: q.name, title: q.title })),
];
const cols: Q[][] = [[], []];
const h = [0, 0];
for (const q of allQuotes) {
  const i = h[0] <= h[1] ? 0 : 1;
  cols[i].push(q);
  h[i] += q.text.length + 160 + (q.video ? 420 : 0);
}
// Schéma problème : trois fronts reliés à toi
// Triangle équilatéral centré sur toi : pastilles à égale distance de toi et entre elles
const C = { x: 280, y: 180 }, R = 155;
const pos = [-150, -30, 90].map((deg) => ({ x: C.x + R * Math.cos((deg * Math.PI) / 180), y: C.y + R * Math.sin((deg * Math.PI) / 180) }));
const fronts = problem.fronts.map((label, i) => ({ label, ...pos[i] }));
// Jonglage : câbles lisses (spline Catmull-Rom, sans angle) qui partent de toi, font le tour d'une pastille et reviennent,
// plus quelques câbles entre domaines. Aléatoire à graine fixe : le dessin ne change pas.
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const r = (a: number, b: number) => a + rnd() * (b - a);
type P = { x: number; y: number };
const spline = (pts: P[]) => {
  let d = `M${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
    const c1 = { x: p1.x + (p2.x - p0.x) / 4.5, y: p1.y + (p2.y - p0.y) / 4.5 };
    const c2 = { x: p2.x - (p3.x - p1.x) / 4.5, y: p2.y - (p3.y - p1.y) / 4.5 };
    d += ` C${c1.x.toFixed(1)} ${c1.y.toFixed(1)} ${c2.x.toFixed(1)} ${c2.y.toFixed(1)} ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
  }
  return d;
};
// Câbles toi ↔ pastille (jamais pastille ↔ pastille) : chaque câble part de toi, boucle autour du centre
// avec des rayons variés, puis rejoint sa pastille. Spline lisse, épaisseur constante.
const O = C, RX = 290, RY = 215;
const ties: string[] = [];
fronts.forEach((f) => {
  for (let n = 0; n < 7; n++) {
    let t = r(0, Math.PI * 2);
    const dir = n % 2 ? 1 : -1;
    const pts: P[] = [C];
    const loops = 2 + Math.floor(rnd() * 3);
    for (let k = 0; k < loops; k++) {
      t += dir * r(1.2, 1.7);
      const rad = k === 0 ? r(0.15, 0.3) : r(0.3, 1);
      const sq = r(0.8, 1.2);
      pts.push({ x: O.x + Math.cos(t) * RX * rad * sq, y: O.y + Math.sin(t) * RY * rad / sq });
    }
    pts.push(f);
    ties.push(spline(pts));
  }
});
---

<div class="a3">
  <header class="a3-bar a3-wrap">
    <a href="#top" class="quiet" aria-label="Damien Pugin, accueil"><Wordmark size={20} /></a>
    <nav class="a3-nav" aria-label="Sections">
      <a class="quiet muted" href="#plan-titre">Le plan</a>
      <a class="quiet muted" href="#temoignages">Témoignages</a>
      <a class="quiet muted" href="#podcast">Podcast</a>
      <a class="quiet muted" href="#about">À propos</a>
    </nav>
    <div class="a3-bar-actions">
      <button class="pd-button mod-icon theme-toggle" data-theme-toggle aria-label="Changer de thème">
        <Icon name="sun" class="ico-sun" /><Icon name="moon" class="ico-moon" />
      </button>
      <a href={whatsapp} class="pd-button">{hero.cta}</a>
    </div>
  </header>

  <main id="top">
    <section class="a3-red-zone">
      <div class="a3-hero a3-wrap">
        <h1 class="a3-display">{hero.title}</h1>
        <div class="a3-cta-group">
          <p class="a3-cta-lead">{hero.ctaLead}</p>
          <a href={whatsapp} class="pd-button mod-primary a3-cta">{hero.cta}</a>
        </div>
      </div>
    </section>

    <section class="a3-sec a3-wrap" id="probleme">
      {problemStyle === "question" ? (
        <div class="a3-stick">
          <h2 class="a3-h2 a3-h2-q">{problem.titleAlt.replace(/ \S+$/, "")} <span class="a3-nowrap">{problem.titleAlt.split(" ").at(-1)} <Saw />&#8239;?</span></h2>
          <p class="a3-q-sub">{problem.titleAltSub}</p>
        </div>
      ) : (
        <div class="a3-stick">
          {problem.questions.map((q) => <p class="a3-ask">{fr(q)}</p>)}
          <h2 class="a3-h2">{problem.title}</h2>
        </div>
      )}
      <div class="a3-body">
        <svg class="a3-fronts" viewBox="-40 -50 640 440" role="img" aria-label={`Tu jongles entre ${problem.fronts.join(", ").toLowerCase()} : tout passe par toi.`}>
          {ties.map((d) => <path class="a3-tie" d={d} />)}
          {fronts.map((f, i) => (
            nodes === "picto" ? (
              <g class="a3-dom">
                <circle cx={f.x} cy={f.y} r="30" />
                <g transform={`translate(${f.x - 14} ${f.y - 14}) scale(1.1667)`}>{icons[i].map((d) => <path d={d} />)}</g>
                <text x={f.x} y={f.y + (f.y > C.y ? 52 : -52)} text-anchor="middle" dominant-baseline="central">{f.label}</text>
              </g>
            ) : nodes === "label" ? (
              <g class="a3-lab">
                <circle cx={f.x} cy={f.y} r="6" />
                <text x={f.x} y={f.y + (f.y > C.y ? 28 : -26)} text-anchor="middle" dominant-baseline="central">{f.label}</text>
              </g>
            ) : (
              <g class:list={["a3-front", { "is-outline": nodes === "outline" }]}>
                <rect x={f.x - 76} y={f.y - 22} width="152" height="44" rx="22" />
                <text x={f.x} y={f.y} text-anchor="middle" dominant-baseline="central">{f.label}</text>
              </g>
            )
          ))}
          <circle class="a3-you" cx={C.x} cy={C.y} r="46" />
          <text class="a3-you-t" x={C.x} y={C.y} text-anchor="middle" dominant-baseline="central">{problem.center}</text>
        </svg>
        {problemStyle === "statement" && <div class="a3-outcome">
          <span class="a3-outcome-k">{problem.outcomeLabel}</span>
          <p>{problem.outcome} <Saw /></p>
        </div>}
      </div>
    </section>

    <section class="a3-words a3-wrap" aria-labelledby="plan-titre">
      <h2 class="a3-plan-title" id="plan-titre"><span>{fr(plan.lead)}</span> {plan.title}</h2>
      <div>
        <svg class="a3-picto" viewBox="0 0 64 64" aria-hidden="true">
          <path d="M8 30 L30 8 H56 V34 L34 56 Z" />
          <circle class="hot-fill" cx="45" cy="19" r="4" />
        </svg>
        <h2>{outcomes[0].title}{outcomes[0].text && <span> {outcomes[0].text}</span>}</h2>
      </div>
      <div>
        <svg class="a3-picto" viewBox="0 0 64 64" aria-hidden="true">
          <rect x="6" y="24" width="14" height="14" rx="2" />
          <rect x="25" y="24" width="14" height="14" rx="2" />
          <rect class="hot-fill" x="44" y="24" width="14" height="14" rx="2" />
        </svg>
        <h2>{outcomes[1].title}{outcomes[1].text && <span> {outcomes[1].text}</span>}</h2>
      </div>
      <div>
        <svg class="a3-picto" viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="32" r="20" />
          <circle class="hot-fill" cx="32" cy="12" r="5" />
          <circle cx="49" cy="42" r="5" class="bg-fill" />
          <circle cx="15" cy="42" r="5" class="bg-fill" />
        </svg>
        <h2>{outcomes[2].title}{outcomes[2].text && <span> {outcomes[2].text}</span>}</h2>
      </div>
    </section>

    <section class="a3-band" id="expert">
      <div class="a3-wrap a3-band-in">
        <div class="a3-band-head">
          <h2 class="a3-h2">{philosophy.title}</h2>
          <p class="a3-band-intro">{philosophy.intro}</p>
        </div>
        <div class="a3-split" role="img" aria-label={philosophy.split.map((p) => `${p.pct} ${p.label.toLowerCase()}`).join(", ")}>
          {philosophy.split.map((p) => (
            <div class:list={["a3-split-part", { "is-hot": p.you }]}>
              <span class="a3-split-bar"></span>
              <strong>{p.pct}</strong>
              <span>{p.label}</span>
            </div>
          ))}
        </div>
        <p class="a3-band-body">{fr(philosophy.body)}</p>
      </div>
    </section>

    <section class="a3-sec a3-wrap" id="temoignages">
      <div class="a3-stick">
        <h2 class="a3-h2">{quotes.title}</h2>
      </div>
      <div class="a3-body">
        <div class="a3-others">
          {cols.map((col) => (
            <ul>
              {col.map((q) => (
                <li>
                  <blockquote>{fr(q.text)}</blockquote>
                  <p><strong>{q.name}</strong><span class="muted">{fr(q.title)}</span></p>
                  {q.video && (
                    <div class="a3-video">
                      <iframe src={`https://www.youtube.com/embed/${q.video}`} title={`Témoignage ${q.name}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>

    <section class="a3-sec a3-wrap" id="podcast">
      <div class="a3-stick">
        <h2 class="a3-h2">{podcast.title}</h2>
        <p class="a3-side">{podcast.sub}</p>
      </div>
      <div class="a3-body a3-frame">
        <iframe src={`https://player.captivate.fm/show/${podcast.captivateShowId}`} title="Podcast Damien Pugin" loading="lazy" scrolling="no" allow="clipboard-write"></iframe>
      </div>
    </section>

    <section class="a3-sec a3-wrap" id="pourquoi">
      <h2 class="a3-h2">{fr(why.title)}</h2>
      <div class="a3-body a3-why">
        {why.lines.map((l) => <p>{l}</p>)}
        <p class="a3-why-punch">{why.punch}</p>
        <p>{why.close}</p>
      </div>
    </section>

    <section class="a3-sec a3-wrap" id="about">
      <h2 class="a3-h2">{about.title}</h2>
      <ol class="a3-body a3-time">
        {about.timeline.map((t) => (
          <li><span class="a3-year">{t.year}</span><p>{t.text}</p></li>
        ))}
      </ol>
    </section>

    <section class="a3-red-zone" id="contact">
      <div class="a3-nl a3-wrap">
        <p class="a3-lead">{fr(contact.lead)}</p>
        <h2 class="a3-display a3-nl-title">{contact.title}</h2>
        <p class="a3-sub">{contact.sub}</p>
        <div class="a3-cta-group">
          <p class="a3-cta-lead">{hero.ctaLead}</p>
          <a href={whatsapp} class="pd-button mod-primary a3-cta">{hero.cta}</a>
        </div>
      </div>
    </section>

  </main>

  <footer class="a3-footer a3-wrap caption muted">
    <span>© {new Date().getFullYear()} {footer.copyright}</span>
    <nav class="a3-footer-links">{footer.links.map((l) => <a class="quiet" href={l.href}>{l.label}</a>)}</nav>
  </footer>
</div>

<style>
  .a3 {
    --on-red: var(--grey-100);
    --on-red-muted: color-mix(in srgb, var(--grey-100) 78%, var(--accent));
    --hot: var(--accent);
  }
  .a3-wrap { max-width: 1280px; margin-inline: auto; padding-inline: 48px; }

  .a3-bar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: var(--space-24); min-height: 60px; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(10px); }
  .a3-nav { display: flex; gap: var(--space-16); margin-left: auto; }
  .a3-bar-actions { display: flex; align-items: center; gap: var(--space-8); }
  .a3 :global(.pd-button) { border-radius: 0; }
  .a3-bar-actions .pd-button:not(.mod-icon) { text-decoration: none; padding: 6px 14px; }

  .a3-display { font-size: clamp(52px, 10.5vw, 156px); line-height: 0.95; font-weight: 700; letter-spacing: -0.045em; text-wrap: balance; }
  .a3-hero { min-height: min(calc(100svh - 60px), 820px); display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; padding-block: 12vh 96px; }
  .a3-hero .a3-display { max-width: 11ch; }
  /* Bloc promesse (hero + contact) : titre, sous-titre, bouton empilés sur le même bord gauche */
  .a3-sub { margin-top: var(--space-32); font-size: clamp(22px, 2.2vw, 30px); line-height: 1.3; font-weight: 500; letter-spacing: -0.015em; max-width: 26em; text-wrap: balance; }
  .a3-lead { font-size: clamp(18px, 1.6vw, 22px); line-height: 1.4; max-width: 30em; margin-bottom: var(--space-24); }
  .a3-cta-group { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-16); margin-top: 48px; }
  .a3-sub + .a3-cta-group { margin-top: 40px; }
  .a3-cta-lead { font-size: clamp(22px, 2.2vw, 30px); line-height: 1.3; font-weight: 500; letter-spacing: -0.015em; }

  /* Principes : picto + mot + une ligne */
  .a3-words .a3-plan-title { grid-column: 1 / -1; font-size: clamp(40px, 6.6vw, 96px); line-height: 1; font-weight: 700; letter-spacing: -0.04em; text-wrap: balance; margin-bottom: 48px; }
  .a3-words .a3-plan-title span { display: block; color: var(--text-muted); }
  .a3-words { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; padding-block: 128px; border-top: 1px solid var(--border); }
  .a3-picto { width: 72px; height: 72px; margin-bottom: var(--space-24); fill: none; stroke: var(--text); stroke-width: 2; stroke-linejoin: round; }
  .a3-picto .hot { stroke: var(--hot); }
  .a3-picto .hot-fill { fill: var(--hot); stroke: var(--hot); }
  .a3-picto .bg-fill { fill: var(--bg); }
  .a3-words h2 span { color: var(--text-muted); }
  .a3-words h2 { font-size: clamp(24px, 2.6vw, 34px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: var(--space-8); }
  .a3-words p { font-size: 17px; line-height: 1.5; color: var(--text-muted); }

  .a3-sec { display: grid; grid-template-columns: 5fr 7fr; gap: 48px; padding-block: 128px; border-top: 1px solid var(--border); }
  .a3-h2 { font-size: clamp(34px, 4.6vw, 64px); line-height: 1.02; font-weight: 700; letter-spacing: -0.035em; text-wrap: balance; }
  .a3-sec > .a3-h2, .a3-stick { align-self: start; position: sticky; top: 96px; }
  .a3-side { margin-top: var(--space-16); font-size: 20px; line-height: 1.5; color: var(--text-muted); }

  /* Problème : tout passe par toi */
  .a3-fronts { display: block; width: 100%; height: auto; overflow: visible; }
  .a3-tie { fill: none; stroke: var(--hot); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .a3-front rect { fill: var(--text); stroke: var(--bg); stroke-width: 5; paint-order: stroke; }
  .a3-front text { font: 600 17px var(--font-sans); fill: var(--bg); letter-spacing: -0.01em; }
  .a3-front.is-outline rect { fill: var(--bg); stroke: var(--accent); stroke-width: 2.5; paint-order: normal; }
  .a3-front.is-outline text { fill: var(--accent); font-weight: 650; }
  :root:not([data-theme="dark"]) .a3-front.is-outline text { fill: color-mix(in srgb, var(--accent) 82%, black); }
  .a3-dom circle { fill: var(--text); stroke: var(--bg); stroke-width: 5; paint-order: stroke; }
  .a3-dom path { fill: none; stroke: var(--bg); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .a3-dom text, .a3-lab text { font: 650 17px var(--font-sans); fill: var(--text); letter-spacing: -0.01em; stroke: var(--bg); stroke-width: 8; stroke-linejoin: round; paint-order: stroke; }
  .a3-lab text { font-size: 20px; }
  .a3-lab circle { fill: var(--accent); stroke: var(--bg); stroke-width: 3; paint-order: stroke; }
  .a3-you { fill: var(--text); stroke: var(--bg); stroke-width: 5; paint-order: stroke; }
  .a3-you-t { font: 700 22px var(--font-sans); fill: var(--bg); letter-spacing: -0.02em; }
  .a3-nowrap { white-space: nowrap; }
  .a3-q-sub { margin-top: 40px; font-size: clamp(22px, 2.2vw, 28px); line-height: 1.3; letter-spacing: -0.015em; color: var(--text-muted); max-width: 16em; text-wrap: balance; }
  .a3-h2-q :global(.a3-saw) { stroke-width: 4; width: 2.6em; vertical-align: 0; }
  .a3-outcome { display: flex; align-items: baseline; gap: var(--space-24); margin-top: 64px; padding-top: var(--space-24); border-top: 1px solid var(--border); }
  .a3-outcome-k { font-size: 14px; color: var(--text-muted); min-width: 5.5em; }
  .a3-outcome p { font-size: clamp(22px, 2.2vw, 28px); font-weight: 500; letter-spacing: -0.015em; line-height: 1.2; }

  .a3-ask { font-size: clamp(20px, 1.8vw, 24px); line-height: 1.35; color: var(--text-muted); margin-bottom: var(--space-16); max-width: 20em; }
  .a3-ask + .a3-h2 { margin-top: var(--space-24); }
  .a3-cta { align-self: flex-start; text-decoration: none; padding: 16px 28px; font-size: 18px; font-weight: 600; border-radius: 0; }
  .a3-h3 { font-size: clamp(26px, 2.8vw, 36px); line-height: 1.1; font-weight: 700; letter-spacing: -0.03em; }
  .a3-others .a3-video { margin-top: var(--space-8); }
  .a3-why { display: flex; flex-direction: column; gap: var(--space-24); }
  .a3-why p { font-size: clamp(20px, 1.8vw, 24px); line-height: 1.4; color: var(--text-muted); }
  .a3-why .a3-why-punch { font-size: clamp(28px, 3vw, 40px); line-height: 1.15; font-weight: 600; letter-spacing: -0.025em; color: var(--text); margin-block: var(--space-16); }

  /* Philosophie : 80 / 20 sur bande inversée */
  .a3-band-body { font-size: clamp(22px, 2.2vw, 30px); line-height: 1.3; font-weight: 500; letter-spacing: -0.015em; color: var(--grey-10); max-width: 30em; text-wrap: balance; }
  .a3-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 8fr) minmax(0, 1fr); gap: 6px; }
  .a3-split-part { white-space: nowrap; }
  .a3-split-part:nth-child(2) { align-items: center; }
  .a3-split-part:last-child { align-items: flex-end; }
  .a3-split-part:last-child .a3-split-bar, .a3-split-part:nth-child(2) .a3-split-bar { align-self: stretch; }
