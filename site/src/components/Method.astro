---
import { site } from "../content/site";
const { method } = site;
---

<section id="methode" class="method border-t hairline" aria-labelledby="method-title">
  <div class="container-prose section-pad">
    <header class="section-head fade-up">
      <p class="eyebrow">{method.eyebrow}</p>
      <h2 id="method-title" class="section-title">
        {method.title}<br /><em>{method.titleAccent}</em>
      </h2>
      <p class="method-intro">{method.intro}</p>
    </header>

    <div class="method-grid">
      {method.steps.map((s) => (
        <article class="method-step fade-up">
          <div class="method-step__num">{s.num}</div>
          <h3 class="method-step__title">{s.title}</h3>
          <p class="method-step__text">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-pad { padding-block: clamp(4rem, 10vh, 7rem); }
  .section-head {
    max-width: 42rem;
    margin-bottom: 4rem;
  }
  .section-title {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin-top: 0.85rem;
  }
  .section-title em {
    font-style: normal;
    color: var(--color-gold);
  }
  .method-intro {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .method-step {
    padding: 2rem 1.5rem 2rem 0;
    border-top: 1px solid var(--color-ink);
    position: relative;
  }
  .method-step__num {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 900;
    font-variation-settings: "opsz" 144, "SOFT" 20;
    line-height: 1;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
    letter-spacing: -0.04em;
  }
  .method-step__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    font-variation-settings: "opsz" 48, "SOFT" 30;
    margin-bottom: 0.65rem;
  }
  .method-step__text {
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (max-width: 840px) {
    .method-grid { grid-template-columns: 1fr; gap: 0; }
    .method-step { padding: 1.75rem 0; }
    .method-step + .method-step { border-top: 1px solid var(--color-hairline); }
    .method-step__num { font-size: 2.75rem; margin-bottom: 1rem; }
  }
</style>
